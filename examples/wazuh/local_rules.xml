<!-- /var/ossec/etc/rules/local_rules.xml -->
<!-- Same source IP, web 4xx responses 20 times in 5 minutes -> level 10, ATT&CK T1595 -->
<group name="local,web,">
  <rule id="100100" level="10" frequency="20" timeframe="300">
    <if_matched_sid>31101</if_matched_sid>
    <same_source_ip />
    <description>Repeated web 4xx - possible scan</description>
    <mitre><id>T1595</id></mitre>
  </rule>
</group>
